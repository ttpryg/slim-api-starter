#!/usr/bin/env php
<?php

$app = require __DIR__.'/config/bootstrap.php';
$config = $app->getContainer()->get('config');

use App\Commands\DbWipeCommand;
use App\Commands\KeyGenerateCommand;
use App\Commands\LogsClearCommand;
use App\Commands\MakeActionCommand;
use App\Commands\MakeMigrationCommand;
use App\Commands\MakeMiddlewareCommand;
use App\Commands\MakeModelCommand;
use App\Commands\MakeTransformerCommand;
use App\Commands\MigrateCommand;
use App\Commands\MigrateRefreshCommand;
use App\Commands\MigrateResetCommand;
use App\Commands\MigrationRollbackCommand;
use App\Commands\SeedCreateCommand;
use App\Commands\SeedRunCommand;
use Symfony\Component\Console\Application;

$application = new Application($config->get('settings.app_name'), $config->get('settings.app_version'));

// register commands
$application->addCommands([
    new DbWipeCommand,
    new KeyGenerateCommand,
    new LogsClearCommand,
    new MakeActionCommand,
    new MakeMiddlewareCommand,
    new MakeModelCommand,
    new MakeMigrationCommand,
    new MakeTransformerCommand,
    new MigrateCommand,
    new MigrateRefreshCommand,
    new MigrateResetCommand,
    new MigrationRollbackCommand,
    new SeedCreateCommand,
    new SeedRunCommand,
]);

exit($application->run());
