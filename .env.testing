APP_ENV=testing
APP_DEBUG=true

# Test Database (SQLite in-memory)
DB_DRIVER=sqlite
DB_DATABASE=:memory:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# CORS Testing
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=false

# JWT Testing
JWT_SECRET=testing-super-secret-key-32-chars-long!
JWT_ALGORITHM=HS256
JWT_TTL=3600

# Rate Limit Testing
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60
