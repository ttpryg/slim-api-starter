{
    "name": "ttpryg/slim-api-starter",
    "description": "Slim 4 API Starter with PHP 8.2 and Docker",
    "type": "project",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0",
        "illuminate/events": "^11.0",
        "php-di/php-di": "^7.0",
        "robmorgan/phinx": "^0.16.11",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit"
    }
}
