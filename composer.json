{
    "name": "ttpryg/slim-api-starter",
    "description": "Slim 4 API Starter with PHP 8.2 and Docker",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^7.1",
        "illuminate/database": "^11.0",
        "illuminate/events": "^11.0",
        "illuminate/pagination": "^11.51",
        "league/fractal": "^0.21.0",
        "monolog/monolog": "^3.10",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "symfony/console": "^7.4",
        "symfony/validator": "^7.4",
        "ttpryg/config": "dev-develop",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/"
        }
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^2.6"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit",
        "fix:check": [
            "rector process --dry-run",
            "pint --test --verbose"
        ],
        "fix": [
            "rector process",
            "pint"
        ]
    }
}
